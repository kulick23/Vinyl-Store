# Keep the existing ASP.NET API as the default provider.
VITE_DATA_PROVIDER=api
VITE_API_URL=https://your-api.example.com

# To run the catalog without the ASP.NET server, switch to Supabase and fill
# the public project values from Project Settings > API.
# VITE_DATA_PROVIDER=supabase
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public browser key only. Never place Stripe secret or Supabase service-role
# keys in a VITE_ variable.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
